# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored; this example is not,
# so keep every real value out of this file.

# az account show --query id -o tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# Where budget alerts go.
budget_alert_email = "you@example.com"

# First of the current month, UTC. Azure rejects a start date outside the current month at
# create time, so update this if you first apply in a later month.
budget_start_date = "2026-09-01T00:00:00Z"

# cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# curl -s https://ifconfig.me
# Guards both SSH and the Postgres firewall. No default on purpose.
ssh_source_cidr = "203.0.113.7/32"

# Optional:
# location            = "westeurope"
# vm_size             = "Standard_B1s"
# dns_label           = "judikat-guard"
# budget_amount_eur   = 5
