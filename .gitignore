.claude

# Local toolchain (JDK 25 + Maven), installed by `make toolchain`
.tools/

# Raw HTML cache, e-Sbírka dumps, anything fetched from the network
data/

# Java
api/target/

# Python
pipeline/.venv/
pipeline/**/__pycache__/
pipeline/*.egg-info/
.pytest_cache/
scripts/**/__pycache__/

# Node
web/node_modules/
web/dist/

# Terraform. State holds the generated database password in cleartext, and tfvars holds the
# subscription id and your SSH source address. Neither belongs in the repository.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/.terraform.tfstate.lock.info
infra/**/tfplan

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
